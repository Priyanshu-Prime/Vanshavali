# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build cache — large, regenerable
/android/.gradle/

# Claude Code local/personal overrides (not shared with the team)
.claude/settings.local.json

# Claude Code session-runtime lock file — churns every session, no project value
.claude/scheduled_tasks.lock

# Supabase backend credentials for autonomous testing (DB password,
# service_role key) — never commit, see supabase/.env.local.example
supabase/.env.local

# Node dependencies for scripts/backend_audit — regenerable via `npm install`,
# package.json/package-lock.json are tracked so it can be reproduced
node_modules/
