#!/bin/sh
# Vanshavali pre-push hook.
# Blocks a push if static analysis or tests fail, so broken code never leaves
# your machine. Enable once with:  git config core.hooksPath .githooks
#
# To bypass in an emergency (not recommended):  git push --no-verify

set -e

echo "[pre-push] Running flutter analyze..."
if ! flutter analyze; then
  echo ""
  echo "[pre-push] BLOCKED: 'flutter analyze' reported issues. Fix them, then push again."
  echo "           (Emergency bypass: git push --no-verify)"
  exit 1
fi

echo "[pre-push] Running flutter test..."
if ! flutter test; then
  echo ""
  echo "[pre-push] BLOCKED: 'flutter test' failed. Fix the failing tests, then push again."
  echo "           (Emergency bypass: git push --no-verify)"
  exit 1
fi

echo "[pre-push] All checks passed. Pushing."
exit 0
